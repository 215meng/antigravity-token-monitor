{
  "name": "antigravity-token-monitor",
  "displayName": "Antigravity TokenScope",
  "description": "Antigravity TokenScope — 原生运行在 Antigravity 内的 Token 与成本可观测性插件，支持精准去重核算、本月/今日首屏看板、按日热力图及 SQLite 直读（基于 ddarkr/antigravity-token-monitor 深度重构）。",
  "version": "1.0.0",
  "publisher": "ddarkr",
  "author": {
    "name": "215meng",
    "url": "https://github.com/215meng"
  },
  "icon": "icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/215meng/antigravity-tokenscope"
  },
  "bugs": {
    "url": "https://github.com/215meng/antigravity-tokenscope/issues"
  },
  "homepage": "https://github.com/215meng/antigravity-tokenscope#readme",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:antigravity-token-monitor.sidebarView",
    "onCommand:antigravity-token-monitor.openDashboard",
    "onCommand:antigravity-token-monitor.refreshNow",
    "onCommand:antigravity-token-monitor.exportNow",
    "onCommand:antigravity-token-monitor.resetCache"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "antigravity-token-monitor",
          "title": "Antigravity Token 监控",
          "icon": "$(graph)"
        }
      ]
    },
    "views": {
      "antigravity-token-monitor": [
        {
          "type": "webview",
          "id": "antigravity-token-monitor.sidebarView",
          "name": "Token 用量概览"
        }
      ]
    },
    "commands": [
      {
        "command": "antigravity-token-monitor.openDashboard",
        "title": "Antigravity Token 监控: 打开监控面板",
        "icon": "$(graph)"
      },
      {
        "command": "antigravity-token-monitor.refreshNow",
        "title": "Antigravity Token 监控: 立即刷新数据",
        "icon": "$(sync)"
      },
      {
        "command": "antigravity-token-monitor.exportNow",
        "title": "Antigravity Token 监控: 立即导出全部会话",
        "icon": "$(export)"
      },
      {
        "command": "antigravity-token-monitor.resetCache",
        "title": "Antigravity Token 监控: 重置缓存与重新索引",
        "icon": "$(trash)"
      }
    ],
    "configuration": {
      "title": "Antigravity Token Monitor",
      "properties": {
        "antigravity-token-monitor.sessionRoot": {
          "type": "string",
          "default": "",
          "description": "Override the Antigravity session root. Leave empty to use ~/.gemini/antigravity."
        },
        "antigravity-token-monitor.debug": {
          "type": "boolean",
          "default": false,
          "description": "Show verbose debug logs in the Antigravity Token Monitor output channel."
        },
        "antigravity-token-monitor.pollIntervalMs": {
          "type": "number",
          "default": 60000,
          "minimum": 10000,
          "description": "How often the extension rescans sessions and recalculates usage."
        },
        "antigravity-token-monitor.historyLimit": {
          "type": "number",
          "default": 120,
          "minimum": 10,
          "description": "How many snapshots to keep per session."
        },
        "antigravity-token-monitor.maxFileBytes": {
          "type": "number",
          "default": 52428800,
          "minimum": 16384,
          "description": "Maximum file size to read during token estimation and JSONL parsing (default 50MB)."
        },
        "antigravity-token-monitor.useRpcExport": {
          "type": "boolean",
          "default": true,
          "description": "When enabled, try exporting Antigravity conversations through the internal RPC into local JSONL artifacts before parsing token usage."
        },
        "antigravity-token-monitor.exportStepsJsonl": {
          "type": "boolean",
          "default": false,
          "description": "When enabled, also export conversation steps into steps.jsonl. This is optional and mainly useful for debugging or transcript inspection."
        },
        "antigravity-token-monitor.rpcExportIntervalMs": {
          "type": "number",
          "default": 300000,
          "minimum": 10000,
          "description": "How often the extension exports Antigravity sessions into background JSONL artifacts when RPC export is enabled."
        },
        "antigravity-token-monitor.rpcTimeoutMs": {
          "type": "number",
          "default": 5000,
          "minimum": 1000,
          "description": "Timeout for internal Antigravity RPC requests used during JSONL artifact export."
        }
      }
    }
  },
  "scripts": {
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "build:plugin": "node scripts/build-plugin.mjs",
    "install:plugin": "node scripts/install-plugin.mjs",
    "package": "npm run compile && npx @vscode/vsce package --no-dependencies",
    "typecheck": "tsc --noEmit",
    "typecheck:webview": "svelte-check --tsconfig ./tsconfig.webview.json",
    "test:webview": "vitest run",
    "usage": "npx tsx scripts/run-token-scan.ts"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@testing-library/svelte": "^5.3.1",
    "@types/node": "^20.17.30",
    "@types/vscode": "^1.96.0",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.25.0",
    "esbuild-svelte": "^0.9.4",
    "jsdom": "^28.1.0",
    "svelte": "^5.53.9",
    "svelte-check": "^4.4.5",
    "typescript": "^5.8.2",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^2.0.4",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  }
}
